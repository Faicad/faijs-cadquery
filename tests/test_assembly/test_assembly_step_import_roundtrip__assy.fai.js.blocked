// source: test_assembly.py::test_assembly_step_import_roundtrip (var assy)
// BLOCKED — ref-side STEP-roundtrip artefact, NOT a missing op.
//
// `assy` is the assembly AFTER `assy.save(step)` + re-import, of the same
// `simple_assy` fixture that `assy_orig` captures. It is parametrized over
// [subshape_assy, boxes0_assy, nested_assy, simple_assy] x [step, xml, xbf];
// the ref harness captured the LAST combination (kind=xbf, assy="simple_assy").
//
// Ref manifest (out/ref/manifest.json) records the two vars as:
//   assy_orig  Compound  volume 9   (f24/e48/v32/s4 — the full 4-box fixture)
//   assy       Compound  volume 8   (f18/e36/v24/s3 — one box DROPPED)
//
// The 1.0-volume drop is `b1` (the bare `Solid.makeBox(1,1,1)` part): CadQuery's
// assembly STEP export omits a part added as a raw Shape, so the round-tripped
// compound is 3 boxes (b2 + the two b3 posts). faijs' binary-BREP round trip
// (and any lossless exporter) keeps all 4 boxes → vol 9, i.e. 12.5% off ref.
//
// NOT reproduced on purpose: hand-building the 3-box compound would fake the
// reference artefact and claim a channel we do not actually have — the plan's
// "don't impersonate" discipline (docs/plans/2026-10-10-cadquery-next-phase-plan.md
// §4.5-4 / §6.2). Left as `.blocked` so it documents the channel and the
// divergence without being swept. The pre-export var (`assy_orig`, vol 9) IS
// ported — see test_assembly_step_import_roundtrip__assy_orig.fai.js, which
// equals test_assembly__simple_assy (bitwise).
//
// CLOSING CONDITION: a STEP exporter that reproduces CadQuery's part-dropping,
// or a ref-side decision to capture the lossless round trip.
import * as cq from '@faicad/faijs-cadquery'
let b1 = await cq.box(cq.Workplane(), 1, 1, 1)
let p1 = await cq.translate(b1, [2.5, -4.5, 0.5])
let b2 = await cq.box(cq.Workplane(), 1, 1, 2)
let p2 = await cq.translate(b2, [3, -4, 0])
let b3a = await cq.box(cq.Workplane(), 1, 1, 3)
let p3 = await cq.translate(b3a, [4, -2, 0])
let b3b = await cq.box(cq.Workplane(), 1, 1, 3)
let p4 = await cq.translate(b3b, [2, -7, 0])
let bytes = await cq.exportBin(cq.Workplane(cq.compound(cq.val(p1), cq.val(p2), cq.val(p3), cq.val(p4))))
let back = await cq.importBin(bytes)
let result = cq.val(back)
