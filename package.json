{
  "name": "@faicad/faijs-cadquery",
  "version": "0.29.5",
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://gitcode.com/Faicad/faijs-cadquery.git"
  },
  "homepage": "https://gitcode.com/Faicad/faijs-cadquery",
  "description": "CadQuery 2.8.0 geometry parity and assembly solver port for faijs",
  "keywords": [
    "cad",
    "faijs",
    "cadquery",
    "geometry",
    "brep",
    "assembly"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./assembly": {
      "types": "./dist/assembly/index.d.ts",
      "default": "./dist/assembly/index.js"
    },
    "./assembly/browser": {
      "types": "./dist/assembly/browser.d.ts",
      "default": "./dist/assembly/browser.js"
    },
    "./sketch": {
      "types": "./dist/sketch-pkg.d.ts",
      "default": "./dist/sketch-pkg.js"
    }
  },
  "files": [
    "dist"
  ],
  "faijs": {
    "autoLift": false
  },
  "dependencies": {},
  "peerDependencies": {
    "@faicad/faijs": "^0.29.0",
    "occt-wasm": "^5.6.0",
    "@faicad/faijs-sketch": "^0.29.0",
    "@faicad/faijs-extra": "^0.29.0"
  },
  "devDependencies": {
    "@faicad/cq-compat-compare": "^0.29.0",
    "@faicad/faijs": "^0.29.0",
    "@faicad/faijs-extra": "^0.29.0",
    "@types/node": "^26.2.0",
    "@types/opentype.js": "^1.3.4",
    "opentype.js": "^1.3.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/fix-import-extensions.mjs dist",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "lint": "eslint src",
    "compat:cand": "tsx tests/run-cand.ts",
    "compat:report": "tsx tests/gen-manifest.ts && tsx tests/run-cand.ts && tsx tests/compare.ts"
  }
}
